# Top-level reverse proxy for WorkSphere.
#
# This is an nginx:alpine `.template` file: the image's docker-entrypoint
# runs `envsubst` over it at container start (nginx's built-in
# NGINX_ENVSUBST support) and writes the result to
# /etc/nginx/conf.d/default.conf. Only variables listed in
# NGINX_ENVSUBST_TEMPLATE_VARS (or all $-prefixed vars if unset) get
# substituted -- we don't currently rely on any runtime substitution here,
# but the .template extension is kept so this is a drop-in place to add
# some later (e.g. $SERVER_NAME) without changing the Dockerfile/compose
# setup.
#
# Routing:
#   /api/, /sanctum/  -> http://backend:8080   (Laravel, via the backend
#                        container's own internal nginx+php-fpm -- see
#                        docker/backend.Dockerfile. Plain HTTP, no FastCGI
#                        plumbing crosses the container boundary.)
#   everything else   -> http://frontend:3000  (Next.js)

upstream backend_upstream {
    server backend:8080;
}

upstream frontend_upstream {
    server frontend:3000;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 25m;

    access_log /dev/stdout;
    error_log  /dev/stderr;

    location /api/ {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
    }

    location /sanctum/ {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Laravel health check, handy to probe from outside the mesh too.
    location /up {
        proxy_pass http://backend_upstream;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Next.js dev/HMR + any websocket usage
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

