# WorkSphere -- environment variables for docker-compose.yml and
# docker-stack.yml (both interpolate ${VAR} references from this file).
#
# Copy this to `.env` and fill in real values before running
# `docker compose up` or `docker stack deploy --env-file .env`.
#
#   cp .env.example .env
#
# IMPORTANT: `.env` should never be committed with real secrets. Keep it
# out of version control (it's already covered by .gitignore) and use a
# proper secrets manager / Docker secrets for anything beyond local
# development or a small single-manager deployment.

MYSQL_DATABASE=worksphere
MYSQL_USER=worksphere
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=rootsecret

# Base URL the Next.js frontend is built against. NEXT_PUBLIC_* variables
# are inlined into the client bundle at build time, so this must be set
# correctly BEFORE `docker build` / `docker compose build` runs -- changing
# it afterwards requires a rebuild, not just a container restart.
NEXT_PUBLIC_API_URL=http://localhost:5393/api/v1

APP_ENV=production
